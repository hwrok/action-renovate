{
  "name": "action-renovate",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@12.10.1",
  "scripts": {
    "spellcheck": "cspell -c utility/cspell/cspell.config.json --no-progress **",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "lint": "pnpm format && pnpm spellcheck",
    "lint:fix": "pnpm format:fix && pnpm spellcheck",
    "lint:actions": "pnpm lint:actionlint && pnpm lint:zizmor",
    "lint:actionlint": "docker run --rm -v \"$PWD:/repo\" -w /repo rhysd/actionlint:1.7.12 -no-color",
    "lint:zizmor": "docker run --rm -v \"$PWD:/repo\" -w /repo ghcr.io/zizmorcore/zizmor:1.30.1 --offline --no-progress .",
    "lint:renovate": "docker run --rm -v \"$PWD:/repo\" -w /repo --entrypoint renovate-config-validator ghcr.io/renovatebot/renovate:44.145.1 --strict --no-global default.json .github/renovate.json",
    "pr:check": "pnpm format && pnpm spellcheck && pnpm lint:actions && pnpm lint:renovate"
  },
  "devDependencies": {
    "cspell": "10.3.6",
    "prettier": "3.9.9"
  }
}
